{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User's matching profile and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "orientation": { "type": "string", "enum": ["hetero", "homo", "bi", "other"] },
        "mbti": { "type": "string" },
        "personality": { "type": "string" },
        "partnerPreferences": { "type": "string" },
        "answers": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "gender", "orientation"]
    },
    "Chat": {
      "title": "Chat Session",
      "description": "A conversation between two users",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastTimestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["participants"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "A single message in a chat",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "text", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Chat session metadata"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a chat"
    }
  }
}
